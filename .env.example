# Bot de Telegram APRS
APRS_API_KEY=tu_api_key_de_aprs_fi
TELEGRAM_TOKEN=tu_token_de_telegram
ADMIN_USER_ID=123456789

# TrackDirect - Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trackdirect
POSTGRES_DB=trackdirect

# TrackDirect - Configuración APRS
APRS_CALLSIGN=N0CALL
APRS_PASSCODE=-1

# Filtro geográfico para Argentina
# Opción 1 - Area filter (bounding box de Argentina): a/latN/lonW/latS/lonE
# Norte: -21°, Oeste: -73°, Sur: -55°, Este: -53°
APRS_FILTER=a/-21/-73/-55/-53

# Opción 2 - Range filter (radio desde centro de Argentina):
# APRS_FILTER=r/-34/-64/2500
# (2500 km desde centro de Argentina: -34° lat, -64° lon)

# Para capturar todo el mundo, dejar vacío o comentar:
# APRS_FILTER=

# TrackDirect - Información del sitio web
SITE_TITLE=APRS Track Direct Argentina
SITE_OWNER_NAME=Tu Nombre
SITE_OWNER_URL=https://tu-sitio.com

# TrackDirect - API Keys de mapas (opcional)
# MAPTILER_KEY=tu_maptiler_key
# GOOGLE_MAPS_KEY=tu_google_key
# HERE_MAPS_KEY=tu_here_key

# TrackDirect - Servidor APRS (aprsc)
APRSC_SERVER_ID=APRS-SERVER
APRSC_SERVER_PASS=12345
APRSC_ADMIN_INFO=Tu Nombre, TU_INDICATIVO
APRSC_EMAIL=tu_email@example.com

# PostgreSQL - Configuración de memoria (opcional)
POSTGRES_SHARED_BUFFERS=2048MB
POSTGRES_CACHE_SIZE=6GB
